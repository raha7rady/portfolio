# این فایل نمونه است — کپی کن به .env (کنار docker-compose.yml) و مقادیر واقعی را قرار بده.
# docker-compose به‌صورت خودکار فایل .env کنار خودش را می‌خواند.
# .env هرگز نباید Commit شود.

# --- ایمیل بک‌اند (فاز ۵) — برای دریافت پیام‌های فرم Contact ---
# پیام Contact همیشه در دیتابیس ذخیره می‌شود، صرف‌نظر از این تنظیمات.
# اعلان ایمیل کاملاً اختیاری است و فقط وقتی EMAIL_NOTIFICATIONS_ENABLED=true باشد فعال می‌شود.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_TO_ADDRESS=

# --- پنل مدیریت پیام‌های Contact ---
# یک رشته تصادفی و طولانی بگذار (مثلاً با: openssl rand -hex 32).
# اگر خالی بماند، Endpointهای /api/admin/contact-messages/* کاملاً غیرفعال می‌مانند (503).
ADMIN_API_KEY=

# --- Google Analytics (فاز ۸) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
