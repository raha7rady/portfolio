# این فایل نمونه است — کپی کن به .env (کنار docker-compose.yml) و مقادیر واقعی را قرار بده.
# docker-compose به‌صورت خودکار فایل .env کنار خودش را می‌خواند.
# .env هرگز نباید Commit شود.

# --- ایمیل بک‌اند (فاز ۵) — برای دریافت پیام‌های فرم Contact ---
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_TO_ADDRESS=

# --- Google Analytics (فاز ۸) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
