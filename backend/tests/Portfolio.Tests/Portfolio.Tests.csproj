    <!-- برای تست End-to-End روی خودِ HTTP Pipeline (AdminApiKeyFilter، Endpointها، Program.cs) -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Portfolio.Application\Portfolio.Application.csproj" />
    <ProjectReference Include="..\..\src\Portfolio.Infrastructure\Portfolio.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Portfolio.Api\Portfolio.Api.csproj" />
  </ItemGroup>

</Project>
