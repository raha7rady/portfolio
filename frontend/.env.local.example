# این فایل نمونه است — کپی کن به .env.local و مقادیر واقعی را قرار بده
# .env.local هرگز نباید Commit شود (در .gitignore ریشه پروژه قرار دارد)

# آدرس بک‌اند ASP.NET Core (از فاز ۵ استفاده می‌شود)
NEXT_PUBLIC_API_URL=http://localhost:5000

# آدرس عمومی سایت (برای متادیتای SEO در فاز ۸ استفاده می‌شود)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
